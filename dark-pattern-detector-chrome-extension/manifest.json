{
  "manifest_version": 3,
  "name": "DarkPatternDetector",
  "version": "3.0",
  "description": "Privacy-first detection and highlighting of manipulative design patterns (Dark Patterns) on web pages. Regex engine with optional on-device AI verification (Gemini Nano).",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "images/icon.svg"
  },
  "icons": {
    "16": "images/icon.svg",
    "48": "images/icon.svg",
    "128": "images/icon.svg"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "images/*.png",
        "patterns.txt"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ]
    }
  ]
}
